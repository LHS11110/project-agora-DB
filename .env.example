# =======================================================
# Agora Database Environment Configuration
# =======================================================
# 이 파일을 복사하여 .env 파일을 생성하고 실제 비밀번호를 설정하세요:
# cp .env.example .env

# 공통 설정
TIMEZONE=Asia/Seoul

# 1. MS SQL 설정
MSSQL_SA_PASSWORD=AgoraStrong@Passw0rd!2026
MSSQL_PID=Express # 무료 운영용: Express, 테스트/개발용: Developer, 상용: Standard
MSSQL_PORT=1433

# 2. Redis Stack 설정
REDIS_PASSWORD=AgoraRedisSecret@Passw0rd!2026
REDIS_PORT=6379
REDIS_INSIGHT_PORT=8001

# 3. Elasticsearch 설정
ELASTIC_PASSWORD=AgoraElasticSecret@Passw0rd!2026
ES_PORT=9200
ES_JAVA_MIN_MEM=1g
ES_JAVA_MAX_MEM=2g
