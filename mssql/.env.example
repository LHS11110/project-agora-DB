# =======================================================
# Agora MS SQL Server Environment Configuration
# =======================================================
TIMEZONE=Asia/Seoul

MSSQL_SA_PASSWORD=CHANGE_ME_9!replace-this
# 무료 운영용: Express, 개발/테스트용: Developer, 상용: Standard
MSSQL_PID=Express
MSSQL_PORT=1433

# 외부 접속 IP 및 외부 포트 설정 (바인딩 및 외부 접속용)
MSSQL_EXTERNAL_IP=127.0.0.1
MSSQL_EXTERNAL_PORT=1433

# 데이터베이스 및 일반 사용자 계정 설정
MSSQL_DB=agora_db
MSSQL_USER=agora_user
MSSQL_PASSWORD=change-me-with-a-strong-application-password
# Self-signed local development certificate only. Set false in production.
DB_TRUST_SERVER_CERTIFICATE=true
MSSQL_TLS_ENABLED=false
MSSQL_TLS_CERTS_DIR=./tls
MSSQL_TLS_CERTIFICATE=/run/secrets/mssql-tls/server.crt
MSSQL_TLS_KEY=/run/secrets/mssql-tls/server.key

# 테이블 이름 설정
MSSQL_TABLE_USERS=users
MSSQL_TABLE_REDIS_SERVER=redis_server
MSSQL_TABLE_CANVAS_INFO=canvas_info
MSSQL_TABLE_CPP_SERVER=cpp_server
