# =======================================================
# Agora Elasticsearch Environment Configuration
# =======================================================
TIMEZONE=Asia/Seoul
AGORA_NET_SUBNET=172.21.0.0/16

ELASTIC_PASSWORD=change-me-with-a-strong-elastic-password
ES_PORT=9200
ES_JAVA_MIN_MEM=1g
ES_JAVA_MAX_MEM=2g

# 접속 바인딩 및 포트. 모든 Elasticsearch 요청은 검증된 HTTPS를 사용합니다.
ES_EXTERNAL_IP=127.0.0.1
ES_EXTERNAL_PORT=9200
ES_SCHEME=https
ES_HTTP_TLS_ENABLED=true
# Supply http.crt, http.key and ca.crt yourself; setup never issues certificates.
ES_TLS_CERTS_DIR=./certs
ES_TLS_CERTIFICATE=/usr/share/elasticsearch/config/certs/http.crt
ES_TLS_KEY=/usr/share/elasticsearch/config/certs/http.key
ES_CA_CERT=./certs/ca.crt
ES_SNAPSHOT_HOST_DIR=./snapshots
ES_LOG_RETENTION_DAYS=90

# 인덱스(데이터베이스 역할) 및 일반 사용자 계정 설정
ES_INDEX=canvas
ES_USER_NAME=agora_user
ES_USER_PASSWORD=change-me-with-a-strong-application-password

# 백엔드 로그 전용 인덱스 및 쓰기 전용 계정
ES_LOG_INDEX=agora-logs
ES_LOG_USER_NAME=agora_log_writer
ES_LOG_USER_PASSWORD=change-me-with-a-strong-log-writer-password

# Separate Korean/semantic metadata projection (original canvas snapshots stay unchanged).
ES_SEARCH_INDEX=canvas-search
