# =======================================================
# Agora Elasticsearch Environment Configuration
# =======================================================
TIMEZONE=Asia/Seoul

ELASTIC_PASSWORD=change-me-with-a-strong-elastic-password
ES_PORT=9200
ES_JAVA_MIN_MEM=1g
ES_JAVA_MAX_MEM=2g

# 외부 접속 IP 및 외부 포트 설정. 기본 HTTP는 TLS를 사용하지 않으므로
# 원격 노출 전 TLS 또는 신뢰된 사설 네트워크를 구성하세요.
ES_EXTERNAL_IP=127.0.0.1
ES_EXTERNAL_PORT=9200

# 인덱스(데이터베이스 역할) 및 일반 사용자 계정 설정
ES_INDEX=canvas
ES_USER_NAME=agora_user
ES_USER_PASSWORD=change-me-with-a-strong-application-password

# 백엔드 로그 전용 인덱스 및 쓰기 전용 계정
ES_LOG_INDEX=agora-logs
ES_LOG_USER_NAME=agora_log_writer
ES_LOG_USER_PASSWORD=change-me-with-a-strong-log-writer-password
