# =======================================================
# Agora Redis Stack Environment Configuration
# =======================================================
TIMEZONE=Asia/Seoul

REDIS_PASSWORD=AgoraRedisSecret@Passw0rd!2026
REDIS_PORT=6379
REDIS_INSIGHT_PORT=8001

# 일반 사용자 계정 및 권한 설정
REDIS_USER=agora_user
REDIS_USER_PASSWORD=AgoraUserSecret@Passw0rd!2026

# RediSearch 인덱스명 및 키 네임스페이스(Prefix) 설정
REDIS_INDEX_NAME=idx:canvas
REDIS_KEY_PREFIX=canvas:

# 호스트 포트 바인딩 IP (0.0.0.0: 모든 인터페이스 수신, 127.0.0.1: 로컬 전용)
# EC2/클라우드 환경에서는 호스트에 공인 IP가 직접 할당되지 않으므로 0.0.0.0 권장
REDIS_BIND_IP=0.0.0.0

# 외부 노출 포트 (호스트 바인딩 및 외부 접속 포트)
REDIS_EXTERNAL_PORT=6379

# MS SQL(redis_server 테이블)에 등록할 외부 접속용 IP (공인 IP 또는 클라이언트 접속용 IP)
REDIS_EXTERNAL_IP=127.0.0.1

# MS SQL 연동 설정 (미지정 시 ../mssql/.env 설정을 자동 참조)
# MSSQL_HOST=127.0.0.1
# MSSQL_PORT=1433
# MSSQL_DB=agora_db
# MSSQL_USER=agora_user
# MSSQL_PASSWORD=AgoraUserSecret@Passw0rd!2026
# MSSQL_TABLE_REDIS_SERVER=redis_server
