# =======================================================
# Agora Redis Stack Environment Configuration
# =======================================================
TIMEZONE=Asia/Seoul

REDIS_PASSWORD=change-me-with-a-strong-redis-admin-password
REDIS_PORT=6379
REDIS_INSIGHT_PORT=8001
REDIS_INSIGHT_BIND_IP=127.0.0.1

# 일반 사용자 계정 및 권한 설정
REDIS_USER=agora_user
REDIS_USER_PASSWORD=change-me-with-a-strong-application-password

# Dedicated read-only Sentinel discovery credentials for the BE clients.
REDIS_SENTINEL_USER=agora_sentinel_reader
REDIS_SENTINEL_PASSWORD=change-me-with-a-strong-sentinel-password
REDIS_SENTINEL_MASTER_NAME=agora-master
REDIS_SENTINELS=

# Redis node, replication and Sentinel traffic must use verified TLS.
REDIS_TLS_ENABLED=true
REDIS_TLS_CERTS_DIR=./tls/server
REDIS_TLS_CERTIFICATE=/run/secrets/redis-tls/server.crt
REDIS_TLS_KEY=/run/secrets/redis-tls/server.key
REDIS_TLS_CA_CERT=/run/secrets/redis-tls/ca.crt
# Set by `python3 ops/configure-db.py prepare` for a new development setup.
REDIS_TLS_CA_CERT_HOST=./tls/ca.crt

# Fixed local lab addresses make TLS certificate identity stable across restarts.
REDIS_HA_SUBNET=172.20.0.0/16
REDIS_PRIMARY_IP=172.20.0.2
REDIS_REPLICA_1_IP=172.20.0.7
REDIS_REPLICA_2_IP=172.20.0.5
REDIS_SENTINEL_1_IP=172.20.0.6
REDIS_SENTINEL_2_IP=172.20.0.3
REDIS_SENTINEL_3_IP=172.20.0.4
REDIS_PRIMARY_UPSTREAM=
REDIS_REPLICA_1_UPSTREAM=redis-primary
REDIS_REPLICA_2_UPSTREAM=redis-primary

# RediSearch 인덱스명 및 키 네임스페이스(Prefix) 설정
REDIS_INDEX_NAME=idx:canvas
REDIS_KEY_PREFIX=canvas:

# 호스트 포트 바인딩 IP (0.0.0.0: 모든 인터페이스 수신, 127.0.0.1: 로컬 전용)
# 원격 접속이 필요하면 사설 IP에 바인딩하고 클라우드 방화벽에서 허용 대상을 제한하세요.
REDIS_BIND_IP=127.0.0.1

# 외부 노출 포트 (호스트 바인딩 및 외부 접속 포트)
REDIS_EXTERNAL_PORT=6379

# MS SQL(redis_server 테이블)에 등록할 외부 접속용 IP (공인 IP 또는 클라이언트 접속용 IP)
REDIS_EXTERNAL_IP=127.0.0.1

# MS SQL 연동 설정 (미지정 시 ../mssql/.env 설정을 자동 참조)
# MSSQL_HOST=127.0.0.1
# MSSQL_PORT=1433
# MSSQL_DB=agora_db
# MSSQL_USER=agora_user
# MSSQL_PASSWORD=change-me-with-a-strong-application-password
# MSSQL_TABLE_REDIS_SERVER=redis_server
